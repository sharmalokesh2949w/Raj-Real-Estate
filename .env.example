PORT=5000
NODE_ENV=development
TRUST_PROXY=
CMS_DATA_DIR=./data
# Optional overrides; keep the database and upload directory on persistent storage in production.
# CMS_DATABASE_PATH=./data/cms.sqlite
# CMS_UPLOAD_DIR=./data/uploads
# Configure with the HTTPS Google Apps Script web-app deployment URL to enable career applications.
GOOGLE_SCRIPT_URL=
# Optional Pages Functions delivery; leave unset until a real Sheet and Apps Script deployment are configured.
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_SHARED_SECRET=
# Local Pages Functions / Wrangler values. Keep real values only in the ignored root .env file.
APP_ENV=local
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-local-value-at-least-32-characters
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# In production, set TRUST_PROXY to the exact trusted reverse proxy IP/subnet or hop count.
# Leave blank when clients connect directly to this Express server.
